# Copy to server/.env for local dev.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/plateai

# Same secret as JWT_SECRET in Next.js .env.local (openssl rand -base64 32)
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL the browser hits (Next.js proxies /api/auth/* to Express /auth/*)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
