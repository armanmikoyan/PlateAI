# Copy to apps/plateServer/.env for local dev.

PORT=

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Local MongoDB without auth:
MONGODB_URI=

JWT_SECRET=

# Google Cloud Console → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FRONTEND_URL=
NODE_ENV=development

# Lemon Squeezy checkout + webhooks
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID_BASIC=
LEMON_SQUEEZY_VARIANT_ID_PRO=
LEMON_SQUEEZY_TEST_MODE=

# Contact form SMTP (Gmail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
