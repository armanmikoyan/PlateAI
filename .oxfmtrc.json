{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next",
    "out",
    "build",
    "node_modules",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "coverage",
    ".next/cache"
  ]
}