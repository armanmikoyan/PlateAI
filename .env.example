# Copy to .env.local for local dev.

# --- Site ---
# Canonical URL for sitemap, robots, and metadata. CI sets this from the
# GitHub Actions variable PRODUCTION_URL (e.g. https://plateai.fit).
NEXT_PUBLIC_SITE_URL=

# --- Auth ---
AUTH_SERVER_URL=http://127.0.0.1:4000


JWT_SECRET=

# --- AI ---
# true = skip real AI calls (fixture + delay). Production must be false.
AI_TEST_MODE=false

# gemini | openai
AI_IMAGE_PROVIDER=gemini

# Required when AI_TEST_MODE=false
AI_PROVIDER_API_KEY=

# Optional. Defaults: gemini-3.6-flash (gemini), gpt-4o-mini (openai)
AI_IMAGE_MODEL=gemini-3.6-flash

# Server vars (MongoDB, Google OAuth): see server/.env.example
