# Copy to .env.local for local dev.

# Express auth server (OAuth + MongoDB). Next proxies /api/auth/* to this URL.
AUTH_SERVER_URL=http://127.0.0.1:4000

# Must match JWT_SECRET in server/.env — used to verify auth cookies in middleware.
JWT_SECRET=

# true = skip real AI calls (fixture + delay). Production must be false.
AI_TEST_MODE=false

# gemini | openai
AI_IMAGE_PROVIDER=gemini

# Required when AI_TEST_MODE=false. Production: environment secret AI_PROVIDER_API_KEY
AI_PROVIDER_API_KEY=

# Optional. Defaults: gemini-3.6-flash (gemini), gpt-4o-mini (openai)
AI_IMAGE_MODEL=gemini-3.6-flash

# Auth server (server/.env) also needs MONGODB_URI, JWT_SECRET, GOOGLE_CLIENT_* — see server/.env.example
